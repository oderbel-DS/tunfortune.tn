---
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/600-italic.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { title, description = SITE.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | La fiscalité du patrimoine pour les cabinets d'expertise comptable`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b1220" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_TN" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="wordmark" href="/" aria-label="TunFortune, accueil">TunFortune<span class="dot" aria-hidden="true">.</span></a>
        <nav aria-label="Navigation principale">
          <a href="/#produit">Le produit</a>
          <a href="/#pilote">Programme pilote</a>
          <a class="nav-cta" href="/#demo">Demander une démo</a>
        </nav>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="foot-grid">
          <div class="foot-brand">
            <p class="wordmark">TunFortune<span class="dot" aria-hidden="true">.</span></p>
            <p>La fiscalité du patrimoine pour les cabinets d'expertise comptable en Tunisie.</p>
          </div>
          <div>
            <p class="foot-h">Le produit</p>
            <ul>
              <li><a href="/#produit">Patrimoine</a></li>
              <li><a href="/#produit">Évaluation immobilière</a></li>
              <li><a href="/#produit">Simulation ISF × IRPP × Patrimoine</a></li>
              <li><a href="/#produit">Déclaration ISF</a></li>
              <li><a href="/#produit">Déclaration IRPP</a></li>
            </ul>
          </div>
          <div>
            <p class="foot-h">Cabinets</p>
            <ul>
              <li><a href="/#pilote">Programme pilote</a></li>
              <li><a href="/#demo">Demander une démo</a></li>
            </ul>
          </div>
          <div>
            <p class="foot-h">Contact</p>
            <ul>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li><a href="/confidentialite">Politique de confidentialité</a></li>
            </ul>
          </div>
        </div>
        <p class="foot-legal">© {year} TunFortune. Les informations de ce site sont générales et ne constituent pas un avis fiscal.</p>
      </div>
      <p class="foot-giant" aria-hidden="true">TunFortune<span>.</span></p>
    </footer>

    <script>
      // Apparition des blocs au défilement. Sans JavaScript ou avec animations réduites, tout reste visible.
      const els = document.querySelectorAll('.reveal');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -10% 0px' });
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--navy) 90%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255,255,255,0.07);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4.5rem; }
  .site-header .wordmark { color: #fff; font-size: 1.7rem; }
  nav { display: flex; align-items: center; gap: clamp(0.75rem, 2.5vw, 2rem); font-size: 0.9rem; }
  nav a { color: #dfe4ec; text-decoration: none; font-weight: 500; }
  nav a:hover { color: #fff; }
  .nav-cta { background: var(--gold); color: var(--navy) !important; font-weight: 600 !important; padding: 0.65rem 1.05rem; border-radius: 999px; }
  .nav-cta:hover { background: #d6ba82; }
  @media (max-width: 640px) { nav a:not(.nav-cta) { display: none; } }

  .site-footer { background: #070c16; color: #8f9bb0; padding-top: clamp(3.5rem, 7vw, 5.5rem); overflow: hidden; font-size: 0.9rem; }
  .foot-grid { display: grid; grid-template-columns: 1.6fr repeat(3, 1fr); gap: 2rem 3rem; padding-bottom: 2.5rem; border-bottom: 1px solid rgba(255,255,255,0.08); }
  .foot-brand .wordmark { color: #fff; font-size: 2rem; margin: 0 0 0.6rem; }
  .foot-brand p:last-child { max-width: 30ch; }
  .foot-h { color: #fff; font-weight: 600; margin: 0 0 0.9rem; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
  .site-footer a { color: #b7c1d0; text-decoration: none; }
  .site-footer a:hover { color: var(--gold); }
  .foot-legal { margin: 1.5rem 0 0; font-size: 0.8rem; max-width: none; }
  .foot-giant {
    margin: clamp(1.5rem, 4vw, 3rem) 0 0; max-width: none; text-align: center; white-space: nowrap;
    font: 700 clamp(4rem, 17vw, 16rem)/0.78 var(--serif); letter-spacing: -0.02em;
    color: transparent; -webkit-text-stroke: 1px rgba(200,169,107,0.28);
    transform: translateY(12%);
  }
  .foot-giant span { color: var(--gold); -webkit-text-stroke: 0; }
  @media (max-width: 820px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-brand { grid-column: 1 / -1; } }
</style>
