---
import Base from '../../layouts/Base.astro';
import { GUIDES, guideIndexable } from '../../data/guides';

// La page n'est proposée aux moteurs de recherche qu'à partir du premier guide relu.
const indexable = GUIDES.some(guideIndexable);
---
<Base
  title="Guides ISF"
  description="Guides pratiques sur l'impôt sur la fortune en Tunisie : assujettissement, barème, biens exonérés et dettes déductibles."
  noindex={!indexable}
  echeance
>
  <section class="g-hero">
    <div class="wrap">
      <p class="kicker">Ressources</p>
      <h1>Guides de l'impôt <em>sur la fortune</em></h1>
      <p class="lead">
        Les règles de l'article 88 de la loi de finances pour 2026 et de la note commune n°13/2026, résumées pour
        préparer les dossiers de vos clients. Information générale, pas un avis fiscal.
      </p>
    </div>
  </section>

  <div class="wrap list">
    <ul>
      {GUIDES.map((g) => (
        <li>
          <a href={`/guides/${g.slug}`}>
            <h2>{g.titre}</h2>
            <p>{g.resume}</p>
            <span class="lire">Lire le guide <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
      <li class="sim">
        <a href="/simulateur-isf">
          <h2>Simulateur&nbsp;: votre client est-il assujetti&nbsp;?</h2>
          <p>Patrimoine net imposable et impôt estimés en une minute, avec le barème du référentiel TunFortune.</p>
          <span class="lire">Ouvrir le simulateur <span aria-hidden="true">→</span></span>
        </a>
      </li>
    </ul>
  </div>
</Base>

<style>
  .g-hero { background: var(--navy); color: #fff; padding: clamp(3rem, 8vw, 5.5rem) 0 clamp(2.5rem, 6vw, 4rem); }
  .kicker { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin: 0 0 1rem; }
  h1 { font-size: var(--step-4); }
  h1 em { font-style: italic; color: var(--gold); }
  .lead { color: #c6cfdb; font-size: 1.1rem; max-width: 56ch; margin: 0; }

  .list { padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(3.5rem, 8vw, 6rem); }
  .list ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .list a { display: flex; flex-direction: column; height: 100%; background: var(--panel); border: 1px solid var(--line); border-radius: 14px; padding: 1.5rem 1.6rem; text-decoration: none; color: var(--ink); transition: border-color 200ms ease; }
  .list a:hover { border-color: var(--navy); }
  .list h2 { font-size: 1.6rem; font-weight: 600; margin-bottom: 0.6rem; }
  .list p { color: var(--muted); font-size: 0.95rem; flex: 1; }
  .lire { font-weight: 600; font-size: 0.9rem; color: var(--gold-ink); }
  .sim a { background: var(--navy); color: #fff; border-color: var(--navy); }
  .sim p { color: #c6cfdb; }
  .sim .lire { color: var(--gold); }
  @media (max-width: 720px) { .list ul { grid-template-columns: 1fr; } }
</style>
